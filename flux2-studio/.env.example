# ---- FLUX.2 Studio settings ----
# Copy this file to ".env" and fill it in.

# Where images are generated:
#   api   = Black Forest Labs cloud API (no GPU needed, pay per image)
#   local = your own NVIDIA GPU via Hugging Face diffusers
FLUX_MODE=api

# --- API mode ---
# Get a key at https://dashboard.bfl.ai  (API Keys section)
BFL_API_KEY=
# BFL model endpoint. flux-2-klein-4b is the cheapest/fastest FLUX.2 model.
BFL_MODEL=flux-2-klein-4b
# Change only if you want the EU/US regional endpoint.
BFL_API_BASE=https://api.bfl.ai/v1

# --- Local GPU mode ---
LOCAL_MODEL_ID=black-forest-labs/FLUX.2-klein-4B
LOCAL_STEPS=4
LOCAL_GUIDANCE=1.0
# Set to 1 if your GPU has less than ~16 GB of memory (slower, but fits).
LOCAL_CPU_OFFLOAD=0

# Web server port (open http://localhost:PORT in your browser)
PORT=7860
